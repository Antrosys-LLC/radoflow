# Copy to .env.local and fill in.
#
# Local development: run `npm run db:start` and the CLI prints these values.
# Cloud: Supabase dashboard → Project Settings → API.
#
# The two NEXT_PUBLIC_ values are needed at BUILD time as well as runtime —
# Next inlines them into the browser bundle when it compiles. A build that ran
# without them ships `undefined` and adding them afterwards will not help
# without a rebuild. See DEPLOYMENT.md.

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Bypasses row-level security. Server-only — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Shared secret the ZKTeco terminals must present when pushing attendance.
# Generate with: openssl rand -hex 32
DEVICE_INGEST_SECRET=""

# Poll the biometric terminals every 30 seconds. Only set this on a machine that
# shares a network with them — a cloud host cannot reach 192.168.x.x, and
# leaving it on there fails every minute forever. Never enable it on more than
# one instance at a time.
DEVICE_SYNC_ENABLED="false"

# Powers the "Ask" assistant (natural-language attendance/leave/payroll
# questions, in Urdu, Roman Urdu or English). Get a key from
# console.anthropic.com → Settings → API Keys. Server-only.
ANTHROPIC_API_KEY=""

# Reads the Anthropic account's own cost report for the Claude Spend screen.
# A separate credential from ANTHROPIC_API_KEY above: an Admin API key
# (sk-ant-admin...), created in the Anthropic Console under Settings ->
# Admin API keys. Optional — without it the screen falls back to this app's
# own per-question tally and says so.
ANTHROPIC_ADMIN_KEY=
