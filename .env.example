# Copy to .env.local and fill in.
#
# Local development: run `npm run db:start` and the CLI prints these values.
# Cloud: Supabase dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Bypasses row-level security. Server-only — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Shared secret the ZKTeco terminals must present when pushing attendance.
# Generate with: openssl rand -hex 32
DEVICE_INGEST_SECRET=""
