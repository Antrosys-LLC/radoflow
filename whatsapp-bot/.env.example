# Where RadoFlow lives, no trailing slash.
RADO_URL=https://your-radoflow-domain.com
# Must equal BOT_SECRET in RadoFlow's own environment (at least 16 characters).
#   openssl rand -hex 32
BOT_SECRET=
# Group ids (they end in @g.us) that may see pay. Find one by typing !id in the group.
# Every other group is a general group and is never sent salaries.
BOT_PAYROLL_GROUPS=
# Optional. When set, the bot answers only in these groups (and in private chats).
BOT_ALLOWED_GROUPS=
